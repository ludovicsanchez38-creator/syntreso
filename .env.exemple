# Configuration de Syntréso. Copier en .env (les scripts d'installation le font).
# Ne jamais partager ce fichier : il contient le jeton d'accès et les clés.

# --- Accès (obligatoire) ---------------------------------------------------------
# Jeton d'accès à l'appli et à l'API (64 caractères hexadécimaux). Les scripts
# install-mac.sh et install-vps.sh le génèrent. À la main : openssl rand -hex 32
SYNTRESO_JETON=

# Port sur la machine (l'appli n'écoute que sur 127.0.0.1)
SYNTRESO_PORT=3900

# --- Assistant IA intégré (optionnel) ------------------------------------------------
# auto (défaut) : actif seulement si une clé est renseignée ci-dessous
# oui : actif même sans clé (Mac où Claude Code est déjà connecté) ; non : désactivé
SYNTRESO_ASSISTANT=auto
# Clé API Anthropic (console.anthropic.com), facturée à l'usage
ANTHROPIC_API_KEY=
# OU jeton d'abonnement Claude, obtenu avec la commande « claude setup-token »
CLAUDE_CODE_OAUTH_TOKEN=
# Modèle utilisé par l'assistant
SYNTRESO_AGENT_MODEL=claude-sonnet-5-5

# --- CRM Twenty (optionnel) -------------------------------------------------------
# Adresse de votre Twenty (sans / final) et clé API (Twenty > Réglages > API & Webhooks)
TWENTY_URL=
TWENTY_KEY=

# --- Cloudflare Access (optionnel, à la place ou en plus du jeton) ---------------------
# Domaine d'équipe (ex. mon-equipe.cloudflareaccess.com) et identifiant d'audience (AUD)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
